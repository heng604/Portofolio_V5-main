# ============================================================================
# Copy this file to ".env" and fill in the values. NEVER commit ".env".
# Variables starting with VITE_ are bundled into the browser: they must be PUBLIC values only.
# Everything else is read by the Node server in /server and stays private.
# ============================================================================

# ---------- Site ----------
SITE_URL=http://localhost:5173            # production: https://your-domain.com
PORT=8787                                 # port of the API server (vite proxies /api to it)
NODE_ENV=development                      # set to production when deploying

# ---------- Admin (the ONLY account allowed in /dashboard) ----------
# Must equal the email in public.admin_email() inside supabase/schema.sql
ADMIN_EMAIL=Seangheng2006@gmail.com

# ---------- Supabase  (Dashboard > Project Settings > API) ----------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY          # public by design; protected by RLS
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY               # SECRET - server only, bypasses RLS

# ---------- Google OAuth ----------
# Configured in Supabase (Authentication > Providers > Google) - the Google client ID/secret
# are pasted THERE, not in this file. See README section "Google OAuth".

# ---------- Resend (contact form) ----------
RESEND_API_KEY=re_YOUR_RESEND_API_KEY                         # SECRET
RESEND_FROM=Portfolio <onboarding@resend.dev>                 # use your verified domain in production
CONTACT_TO_EMAIL=Seangheng2006@gmail.com                      # optional, defaults to ADMIN_EMAIL

# ---------- Bakong / KHQR ----------
BAKONG_ENV=sandbox                                            # sandbox | production (shown in the UI)
BAKONG_ACCOUNT_ID=yourname@bank                               # your Bakong account ID, e.g. theng_seangheng@aclb
BAKONG_MERCHANT_NAME=Theng Seangheng
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_API_BASE_URL=https://api-bakong.nbc.gov.kh             # optional, this is the default
BAKONG_API_TOKEN=YOUR_BAKONG_OPEN_API_TOKEN                   # SECRET. Optional for GENERATING the QR; required for the auto success popup
BAKONG_QR_TTL_SECONDS=600                                     # QR validity in seconds (120-3600)
# Needed when the site runs OUTSIDE Cambodia (e.g. Vercel) and Bakong answers 401/403 with an HTML/empty body.
# Run relay/server.js on a Cambodian host (RELAY_SECRET there) and point the website server at it:
BAKONG_RELAY_URL=                                             # e.g. https://your-tunnel.trycloudflare.com   (SERVER only)
BAKONG_RELAY_SECRET=                                          # SECRET, must equal RELAY_SECRET on the relay
PAYMENT_SIGNING_SECRET=                                       # SECRET, 32+ random chars: signs the QR payment tokens (recommended)
