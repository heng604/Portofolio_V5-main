# =====================================================================
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# Variables starting with VITE_ are PUBLIC (shipped to the browser).
# Everything else is SERVER-ONLY secret configuration.
# =====================================================================

# ---------- Public (browser) ----------
# Supabase dashboard > Project Settings > API > Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase dashboard > Project Settings > API > "anon" / "publishable" key (safe for browsers; protected by RLS)
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Leave empty for same-origin (/api). Only set if the API is hosted on another domain.
VITE_API_BASE_URL=

# ---------- Server only ----------
# Public URL of the site (no trailing slash). Local: http://localhost:5173
SITE_URL=http://localhost:5173
PORT=3001

# Same Supabase project URL as above
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase > Project Settings > API > "service_role" key. SECRET: bypasses RLS. Server only!
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# The ONLY account allowed into the admin dashboard (server-side check).
# The same address is hard-coded in supabase/schema.sql (function public.is_admin) - keep both in sync.
ADMIN_EMAIL=Seangheng2006@gmail.com

# Any long random string; used to hash visitor IPs before storing them.
IP_HASH_SALT=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ---------- Google OAuth ----------
# Google OAuth is configured INSIDE Supabase (Authentication > Providers > Google), not in this file.
# Client ID / secret from Google Cloud Console go into the Supabase dashboard. See README step 5.

# ---------- Resend (contact form) ----------
# https://resend.com/api-keys
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
# Testing without a domain: onboarding@resend.dev (can only deliver to your own Resend account email).
# Production: an address on a domain you verified in Resend, e.g. Portfolio <contact@yourdomain.com>
RESEND_FROM_EMAIL=Portfolio <onboarding@resend.dev>
CONTACT_TO_EMAIL=Seangheng2006@gmail.com

# ---------- Bakong KHQR ----------
# sandbox = NBC test environment (not real money). production = real payments.
BAKONG_MODE=sandbox
# Optional override. Defaults: sandbox https://sit-api-bakong.nbc.gov.kh | production https://api-bakong.nbc.gov.kh
BAKONG_API_BASE_URL=
# Token from the Bakong Open API portal (https://api-bakong.nbc.gov.kh). Tokens expire; renew when needed.
BAKONG_API_TOKEN=YOUR_BAKONG_API_TOKEN
# Your Bakong account ID, format username@bank (e.g. theng_seangheng@aclb)
BAKONG_ACCOUNT_ID=YOUR_NAME@BANK
# Latin-script name shown inside the QR (max 25 chars). Khmer display name is set in Dashboard > Settings.
BAKONG_MERCHANT_NAME=Theng Seangheng
BAKONG_MERCHANT_CITY=Phnom Penh
# Optional phone number embedded in the QR
BAKONG_MOBILE_NUMBER=
# QR validity in minutes (2-60)
BAKONG_QR_EXPIRES_MINUTES=10
