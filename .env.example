# Frontend public values (safe to expose; use Supabase anon/publishable key only)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
VITE_API_BASE_URL=http://localhost:8787

# Backend only — NEVER prefix secrets with VITE_
API_PORT=8787
SITE_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
ADMIN_EMAIL=Seangheng2006@gmail.com
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Google OAuth is configured in Supabase Auth > Providers > Google.
# Add the Supabase callback URL to Google Cloud OAuth client settings.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET

# Resend: verify sender domain in Resend, then use the verified sender address.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=Portfolio Contact <contact@your-verified-domain.example>
CONTACT_TO_EMAIL=Seangheng2006@gmail.com

# Bakong Open API. Use SIT/sandbox values for tests, production only after approval.
BAKONG_MODE=sandbox
BAKONG_API_BASE_URL=https://sit-api-bakong.nbc.gov.kh
BAKONG_API_TOKEN=YOUR_BAKONG_API_TOKEN
BAKONG_ACCOUNT_ID=your_bakong_account_id
BAKONG_ACCOUNT_NAME=Theng Seangheng
BAKONG_MERCHANT_CITY=PHNOM PENH
